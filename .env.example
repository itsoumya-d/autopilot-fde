# ── AutoPilot FDE environment reference ─────────────────────────────────────
# Copy to .env and fill in what you use. NOTHING here is required for the
# offline demo: the server seeds its own demo workspace and auto-discovers on
# first boot with every variable unset.

# Security ────────────────────────────────────────────────────────────────────
# Shared key for MUTATING endpoints (deploy, approve, sync, discover...).
# Unset = endpoints are OPEN (fine for localhost demo; a startup warning fires).
# ALWAYS set this for any deployment another human can reach.
AUTOPILOT_API_KEY=

# Refuse unsigned WhatsApp webhook payloads outright instead of accepting them
# with a warning. Set to 1 for anything shared or internet-reachable.
AUTOPILOT_REQUIRE_SIGNED_WEBHOOKS=

# Comma-separated browser origins allowed by CORS.
# Default: http://localhost:3000,http://127.0.0.1:3000 (Next.js dev server).
# Set explicitly in production, e.g. https://dashboard.example.com
AUTOPILOT_CORS_ORIGINS=

# Max simulation requests per client per minute (CPU guard). 0 disables.
AUTOPILOT_RATE_LIMIT_PER_MIN=60

# WhatsApp Cloud API ─────────────────────────────────────────────────────────
# Webhook subscription handshake token (Meta dashboard value).
WHATSAPP_VERIFY_TOKEN=
# App secret used to verify X-Hub-Signature-256 on inbound payloads.
WHATSAPP_APP_SECRET=
# Phone number ID to filter deliveries; empty accepts all.
WHATSAPP_PHONE_NUMBER_ID=

# Slack ingestion ─────────────────────────────────────────────────────────────
# Used only by POST /api/channels/slack/sync. Read-only bot token.
# Required scopes: channels:history, channels:read (groups:history for private channels).
SLACK_BOT_TOKEN=xoxb-replace-with-read-only-bot-token

# Optional LLM enrichment (off by default) ───────────────────────────────────
# Set to 1 to enable; failures fall back to the rule-based enhancer.
AUTOPILOT_LLM_ENHANCE=
# OpenAI-compatible endpoint settings used when enrichment is on.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Frontend ────────────────────────────────────────────────────────────────────
# Browser app defaults to http://127.0.0.1:8000/api; set this when deploying separately.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
