# Used only by the backend Slack sync endpoint. Never commit a real token.
# Required Slack scopes: channels:history, channels:read (and groups:history for private channels, if needed).
SLACK_BOT_TOKEN=xoxb-replace-with-read-only-bot-token

# Browser app defaults to http://127.0.0.1:8000/api; set this when deploying separately.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
